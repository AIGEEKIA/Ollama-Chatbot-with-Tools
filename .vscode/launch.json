{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "🚀 Chatbot Ollama (Start & Debug)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "src.main:app",
                "--host", "0.0.0.0",
                "--port", "8000",
                "--reload"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "OLLAMA_BASE_URL": "http://localhost:11434",
                "MODEL_NAME": "llama3.2",
                "PYTHONPATH": "${workspaceFolder}"
            },
            "preLaunchTask": "🚀 Pré-démarrage complet",
            "postDebugTask": "🌐 Ouvrir interface web"
        },
        {
            "name": "🧪 Test Outils",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/test_tools.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "⚡ Démarrage Rapide",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/quick_start.py",
            "args": ["start"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        }
    ]
}